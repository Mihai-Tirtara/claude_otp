{
    "version": "1.0",
    "description": "Skill activation triggers for Claude Code. Controls when skills automatically suggest or block actions for OTP development.",
    "skills": {
        "coding-guidelines": {
            "type": "domain",
            "enforcement": "suggest",
            "priority": "high",
            "description": "Grails/Groovy development patterns for OTP bioinformatics platform",
            "promptTriggers": {
                "keywords": [
                    "grails",
                    "groovy",
                    "controller",
                    "service",
                    "domain",
                    "GORM",
                    "GSP",
                    "view",
                    "workflow",
                    "OtpWorkflow",
                    "WorkflowRun",
                    "WorkflowStep",
                    "Job",
                    "artefact",
                    "Spring Security",
                    "@PreAuthorize",
                    "@Transactional",
                    "Spock",
                    "integration test",
                    "workflow test",
                    "unit test",
                    "Cypress",
                    "E2E test",
                    "Liquibase",
                    "migration",
                    "changelog",
                    "constraint",
                    "validation",
                    "Bootstrap",
                    "asset pipeline",
                    "toaster",
                    "CodeNarc",
                    "ESLint",
                    "MVC",
                    "business logic",
                    "bioinformatics",
                    "pipeline",
                    "NGS",
                    "cluster job",
                    "PBS",
                    "LSF",
                    "LDAP",
                    "OAuth2",
                    "Keycloak"
                ],
                "intentPatterns": [
                    "(create|add|implement|build).*?(controller|action|endpoint)",
                    "(create|add|implement|build).*?(service|business logic)",
                    "(create|add|implement|build).*?(domain|entity|model)",
                    "(create|add|implement|build).*?(workflow|WorkflowStep|Job)",
                    "(create|add|implement|build).*?(GSP|view|page)",
                    "(fix|handle|debug).*?(error|exception|bug)",
                    "(add|implement).*?(security|authorization|@PreAuthorize)",
                    "(add|implement).*?(validation|constraint)",
                    "(add|implement).*?(test|Spock|integration test|workflow test)",
                    "(create|add|write).*?(migration|Liquibase|changelog)",
                    "(organize|structure|refactor).*?(service|controller|domain)",
                    "(how to|best practice).*?(grails|groovy|GORM|workflow)",
                    "(query|find|search).*?(database|GORM|domain)",
                    "(handle|manage).*?(transaction|@Transactional)"
                ]
            },
            "fileTriggers": {
                "pathPatterns": [
                    "grails-app/controllers/**/*.groovy",
                    "grails-app/services/**/*.groovy",
                    "grails-app/domain/**/*.groovy",
                    "grails-app/views/**/*.gsp",
                    "grails-app/conf/**/*.groovy",
                    "grails-app/assets/javascripts/**/*.js",
                    "grails-app/assets/stylesheets/**/*.less",
                    "grails-app/assets/stylesheets/**/*.css",
                    "src/main/groovy/**/*.groovy",
                    "src/test/groovy/**/*Spec.groovy",
                    "src/integration-test/**/*IntegrationSpec.groovy",
                    "src/workflow-test/**/*.groovy",
                    "migrations/**/*.sql",
                    "migrations/changelogs/**/*.groovy"
                ],
                "pathExclusions": [
                    "build/**",
                    ".gradle/**",
                    "target/**",
                    "out/**",
                    "**/node_modules/**"
                ],
                "contentPatterns": [
                    "class.*Controller\\s*\\{",
                    "class.*Service\\s*\\{",
                    "class.*Domain\\s*\\{",
                    "@Transactional",
                    "@PreAuthorize",
                    "@Secured",
                    "implements\\s+OtpWorkflow",
                    "implements\\s+Validateable",
                    "extends\\s+Specification",
                    "static\\s+constraints\\s*=\\s*\\{",
                    "static\\s+mapping\\s*=\\s*\\{",
                    "WorkflowRun",
                    "WorkflowStep",
                    "findAllBy",
                    "findBy",
                    "createCriteria",
                    "withCriteria",
                    "def\\s+\\w+\\(.*\\)\\s*\\{",
                    "render.*as\\s+JSON",
                    "\\$\\.otp\\.",
                    "grails\\.gorm\\.transactions"
                ]
            }
        }
    }
}
